---
import GithubIcon from './icons/GithubIcon.astro';
import { Button } from './ui/button/index.js';
import { Separator } from './ui/separator/index.js';

const githubUrl = 'https://github.com/sunriselayer/sunrise-edge';
const year = new Date().getFullYear();
---

<footer class="border-border bg-muted/35 border-t">
	<div class="container py-10 md:py-12">
		<div class="flex flex-col gap-8 sm:flex-row sm:items-center sm:justify-between">
			<div class="flex items-center gap-3">
				<img src="/favicon.svg" alt="" class="size-8" width="32" height="32" loading="lazy" />
				<div>
					<p class="text-sm font-semibold">Sunrise</p>
					<p class="text-muted-foreground text-xs">Infrastructure that rises with demand.</p>
				</div>
			</div>
			<div class="flex flex-wrap items-center gap-3">
				<Button href="#faq" variant="ghost">FAQ</Button>
				<Button href="https://cosmos.sunriselayer.io/" variant="ghost">Previous Sunrise</Button>
				<Button href={githubUrl} variant="outline">
					<GithubIcon data-icon="inline-start" />
					GitHub
				</Button>
			</div>
		</div>
		<Separator class="my-8" />
		<div class="text-muted-foreground flex flex-col gap-2 text-xs sm:flex-row sm:justify-between">
			<p>© {year} sunriselayer. All rights reserved.</p>
			<p>Cosmos Sunrise ends 5 October 2026, 12:00 UTC at height 6,504,000 (v2.0.0).</p>
		</div>
	</div>
</footer>
