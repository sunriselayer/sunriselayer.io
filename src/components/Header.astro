---
import GithubIcon from './icons/GithubIcon.astro';
import { Button } from './ui/button/index.js';

const githubUrl = 'https://github.com/sunriselayer/sunrise-edge';
const isHome = Astro.url.pathname === '/';
const topHref = isHome ? '#top' : '/#top';
const edgeHref = isHome ? '#edge' : '/#edge';
const architectureHref = isHome ? '#architecture' : '/#architecture';
---

<header class="border-border bg-background/90 sticky top-0 z-50 border-b backdrop-blur-xl">
	<div class="container flex h-16 items-center justify-between">
		<a href={topHref} class="flex items-center gap-3" aria-label="Sunrise home">
			<img src="/favicon.svg" alt="" class="size-8" width="32" height="32" />
			<span class="hidden text-sm font-semibold tracking-[0.18em] uppercase sm:inline">Sunrise</span
			>
		</a>

		<div class="flex items-center gap-2">
			<nav class="flex items-center gap-1 md:hidden" aria-label="Mobile navigation">
				<Button href={architectureHref} variant="ghost" size="sm">Why Edge</Button>
			</nav>
			<nav class="hidden items-center gap-7 md:flex" aria-label="Primary navigation">
				<a
					class="text-muted-foreground hover:text-foreground text-sm transition-colors"
					href={edgeHref}>Edge</a
				>
				<a
					class="text-muted-foreground hover:text-foreground text-sm transition-colors"
					href={architectureHref}
				>
					Architecture
				</a>
			</nav>
			<Button
				href={githubUrl}
				variant="outline"
				size="icon"
				aria-label="View Sunrise Edge on GitHub"
			>
				<GithubIcon />
			</Button>
		</div>
	</div>
</header>
