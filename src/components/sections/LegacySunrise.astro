---
import { Archive, ExternalLink } from '@lucide/astro';

import { Button } from '../ui/button/index.js';
import * as Card from '../ui/card/index.js';

const legacyAppUrl = 'https://app.sunriselayer.io';
---

<section id="previous-sunrise" class="section bg-muted/35 relative isolate overflow-hidden">
	<div class="legacy-glow pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
	<div class="container">
		<Card.Root class="overflow-hidden">
			<Card.Header>
				<div class="flex items-center gap-3">
					<div class="feature-icon feature-icon-muted">
						<Archive class="size-6" stroke-width={1.8} />
					</div>
					<p
						class="text-muted-foreground font-mono text-xs font-semibold tracking-[0.2em] uppercase"
					>
						Previous Sunrise
					</p>
				</div>
				<Card.Title>Looking for the existing Sunrise app?</Card.Title>
				<Card.Description>
					Sunrise Edge is the next-generation protocol now in development. The previous Sunrise
					application remains available while the new architecture takes shape.
				</Card.Description>
			</Card.Header>
			<Card.Content>
				<p class="text-muted-foreground max-w-2xl text-sm leading-relaxed">
					Continue to the current app to access the earlier Sunrise network experience.
				</p>
			</Card.Content>
			<Card.Footer>
				<Button href={legacyAppUrl} variant="outline" size="lg" target="_blank" rel="noreferrer">
					Open app.sunriselayer.io
					<ExternalLink data-icon="inline-end" />
				</Button>
			</Card.Footer>
		</Card.Root>
	</div>
</section>
