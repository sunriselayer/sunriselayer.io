---
import { Archive, ArrowRight, ExternalLink } from '@lucide/astro';

import { Button } from '../ui/button/index.js';
import * as Card from '../ui/card/index.js';

const previousSiteUrl = 'https://cosmos.sunriselayer.io/';
---

<section id="previous-sunrise" class="section bg-muted/35 relative isolate overflow-hidden">
	<div class="legacy-glow pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
	<div class="container">
		<Card.Root class="overflow-hidden">
			<Card.Header>
				<div class="flex items-center gap-3">
					<div class="feature-icon feature-icon-muted">
						<Archive class="size-6" stroke-width={1.8} />
					</div>
					<p
						class="text-muted-foreground font-mono text-xs font-semibold tracking-[0.2em] uppercase"
					>
						Previous Sunrise
					</p>
				</div>
				<Card.Title>Cosmos Sunrise shuts down on 5 October at 12:00 UTC.</Card.Title>
				<Card.Description>
					At the v2.0.0 upgrade on 5 October 2026, height 6,504,000, the network, app, and explorer
					stop. The existing app will no longer be available after shutdown.
				</Card.Description>
			</Card.Header>
			<Card.Content>
				<p class="text-muted-foreground max-w-2xl text-sm leading-relaxed">
					Holdings on that network are carried over to Sunrise Edge. You do not need to move funds
					or use the previous app before shutdown. The previous site remains available at
					cosmos.sunriselayer.io until then.
				</p>
			</Card.Content>
			<Card.Footer class="flex flex-wrap gap-3">
				<Button href={previousSiteUrl} variant="outline" size="lg" target="_blank" rel="noreferrer">
					Open cosmos.sunriselayer.io
					<ExternalLink data-icon="inline-end" />
				</Button>
				<Button href="/migration/" variant="ghost" size="lg">
					Migration guide
					<ArrowRight data-icon="inline-end" />
				</Button>
			</Card.Footer>
		</Card.Root>
	</div>
</section>
