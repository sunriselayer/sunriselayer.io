---
import { Archive, ExternalLink } from '@lucide/astro';

import { Button } from '../ui/button/index.js';
import * as Card from '../ui/card/index.js';

const previousSiteUrl = 'https://cosmos.sunriselayer.io/';
---

<section id="previous-sunrise" class="section bg-muted/35 relative isolate overflow-hidden">
	<div class="legacy-glow pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
	<div class="container">
		<Card.Root class="overflow-hidden">
			<Card.Header>
				<div class="flex items-center gap-3">
					<div class="feature-icon feature-icon-muted">
						<Archive class="size-6" stroke-width={1.8} />
					</div>
					<p
						class="text-muted-foreground font-mono text-xs font-semibold tracking-[0.2em] uppercase"
					>
						Previous Sunrise
					</p>
				</div>
				<Card.Title class="text-lg font-semibold tracking-tight">
					Cosmos Sunrise ends at v2.0.0.
				</Card.Title>
				<Card.Description>
					The cosmos Sunrise network and its previous site stop at the v2.0.0 upgrade — 5 October
					2026, 12:00 UTC, height 6,504,000. After that height the existing app is no longer
					provided.
				</Card.Description>
			</Card.Header>
			<Card.Content>
				<p class="text-muted-foreground max-w-2xl text-sm leading-relaxed">
					Holdings on that network are carried over to Sunrise Edge. You do not need to use the
					previous app before it ends. The previous site, including its app and explorer, remains at
					cosmos.sunriselayer.io until shutdown.
				</p>
			</Card.Content>
			<Card.Footer>
				<Button href={previousSiteUrl} variant="outline" size="lg" target="_blank" rel="noreferrer">
					Open cosmos.sunriselayer.io
					<ExternalLink data-icon="inline-end" />
				</Button>
			</Card.Footer>
		</Card.Root>
	</div>
</section>
