---
// Hero for the Sunrise Edge migration: all holdings carry over, holders do
// nothing, and cosmos Sunrise ends at v2.0.0 (5 October 2026, 12:00 UTC,
// height 6,504,000).
import { ArrowDown } from '@lucide/astro';

import GithubIcon from '../icons/GithubIcon.astro';
import { Button } from '../ui/button/index.js';

const githubUrl = 'https://github.com/sunriselayer/sunrise-edge';

const shutdownFacts = [
	{
		label: 'Shutdown',
		value: '5 October 2026\n12:00 UTC'
	},
	{
		label: 'Height',
		value: '6,504,000'
	},
	{
		label: 'Upgrade',
		value: 'v2.0.0'
	}
];
---

<section id="top" class="border-border relative isolate overflow-hidden border-b">
	<div class="grid-backdrop pointer-events-none absolute inset-0 -z-20" aria-hidden="true"></div>
	<div class="hero-wash pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>

	<div
		class="container grid min-h-[calc(100svh-4rem)] items-center gap-14 py-20 lg:grid-cols-[1.08fr_0.92fr] lg:py-24"
	>
		<div id="edge" class="flex flex-col items-start gap-7">
			<div class="flex flex-col gap-5">
				<p class="text-foreground font-mono text-xs font-semibold tracking-[0.22em] uppercase">
					Migration to Sunrise Edge
				</p>
				<h1
					class="text-5xl leading-[0.98] font-semibold tracking-[-0.055em] sm:text-6xl lg:text-7xl xl:text-[5.5rem]"
				>
					Your assets
					<span class="hero-gradient block">move with you.</span>
				</h1>
				<p class="text-muted-foreground max-w-2xl text-lg leading-relaxed md:text-xl">
					Sunrise is moving to Sunrise Edge, a serverless Layer 1. Every holding on cosmos Sunrise
					is carried over. You do not need to take any action.
				</p>
			</div>
			<dl class="grid w-full max-w-2xl gap-4 sm:grid-cols-3">
				{
					shutdownFacts.map((fact) => (
						<div class="border-border bg-card/80 rounded-3xl border px-4 py-3 shadow-sm">
							<dt class="text-muted-foreground font-mono text-[0.65rem] font-semibold tracking-[0.18em] uppercase">
								{fact.label}
							</dt>
							<dd class="text-foreground mt-1 text-sm font-medium tracking-tight whitespace-pre-line">
								{fact.value}
							</dd>
						</div>
					))
				}
			</dl>
			<div class="flex flex-wrap gap-3">
				<Button href={githubUrl} size="lg">
					<GithubIcon data-icon="inline-start" />
					Explore Sunrise Edge
				</Button>
				<Button href="#faq" variant="outline" size="lg">
					Read the FAQ
					<ArrowDown data-icon="inline-end" />
				</Button>
			</div>
		</div>

		<div class="relative mx-auto w-full max-w-xl" aria-hidden="true">
			<div class="edge-visual relative aspect-square">
				<div class="orbit orbit-outer"></div>
				<div class="orbit orbit-middle"></div>
				<div class="orbit orbit-inner"></div>
				<div class="edge-core">
					<img src="/favicon.svg" alt="" class="size-20 sm:size-24" width="96" height="96" />
				</div>
				<div class="edge-node node-one"><span>event</span></div>
				<div class="edge-node node-two"><span>state</span></div>
				<div class="edge-node node-three"><span>proof</span></div>
				<div class="edge-node node-four"><span>commit</span></div>
			</div>
		</div>
	</div>
</section>
